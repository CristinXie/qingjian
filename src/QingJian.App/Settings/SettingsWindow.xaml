<Window x:Class="QingJian.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Icon="/QingJian.App;component/Assets/qingjian.ico"
        Width="720"
        Height="560"
        MinWidth="720"
        MinHeight="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        Loaded="SettingsWindow_OnLoaded"
        PreviewKeyDown="SettingsWindow_OnPreviewKeyDown">
    <Window.Resources>
        <Style x:Key="SettingsTabItemStyle" TargetType="TabItem">
            <Setter Property="Width" Value="144" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource SelectedNoteBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,24" />
        </Style>

        <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="SegmentedRadioStyle" TargetType="RadioButton">
            <Setter Property="MinWidth" Value="82" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegmentBorder"
                                Background="{StaticResource PanelBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Background" Value="{StaticResource SelectedNoteBackgroundBrush}" />
                                <Setter TargetName="SegmentBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReadOnlyFieldStyle" TargetType="TextBox">
            <Setter Property="AcceptsReturn" Value="False" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="SettingsTabControl"
                    Grid.Row="0"
                    TabStripPlacement="Left"
                    BorderThickness="0"
                    Background="Transparent"
                    Padding="16"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    ItemContainerStyle="{StaticResource SettingsTabItemStyle}">
            <TabItem Header="常规">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,8,24,24">
                        <TextBlock Text="常规" Style="{StaticResource SectionHeadingStyle}" />
                        <CheckBox x:Name="LaunchAtStartupCheckBox"
                                  Content="开机自动启动 QingJian"
                                  FontSize="14"
                                  Checked="LaunchAtStartupCheckBox_OnChanged"
                                  Unchecked="LaunchAtStartupCheckBox_OnChanged" />
                        <CheckBox x:Name="MinimizeToTrayCheckBox"
                                  Content="最小化主窗口时隐藏到系统托盘"
                                  FontSize="14"
                                  Margin="0,16,0,0" />
                        <CheckBox x:Name="CloseToTrayCheckBox"
                                  Content="关闭主窗口时隐藏到系统托盘"
                                  FontSize="14"
                                  Margin="0,16,0,0" />
                        <CheckBox x:Name="StartMinimizedCheckBox"
                                  Content="开机启动时隐藏到系统托盘"
                                  FontSize="14"
                                  Margin="0,16,0,0"
                                  IsEnabled="False" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="编辑">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,8,24,24">
                        <TextBlock Text="编辑" Style="{StaticResource SectionHeadingStyle}" />
                        <TextBlock Text="默认编辑模式"
                                   Style="{StaticResource SettingLabelStyle}"
                                   Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="WysiwygModeRadioButton"
                                         GroupName="EditorMode"
                                         Content="所见即所得"
                                         Style="{StaticResource SegmentedRadioStyle}" />
                            <RadioButton x:Name="MarkdownModeRadioButton"
                                         GroupName="EditorMode"
                                         Content="Markdown"
                                         Style="{StaticResource SegmentedRadioStyle}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="快捷便签">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,8,24,24">
                        <TextBlock Text="快捷便签" Style="{StaticResource SectionHeadingStyle}" />
                        <CheckBox x:Name="HotkeyEnabledCheckBox"
                                  Content="启用全局快捷键"
                                  FontSize="14"
                                  Checked="HotkeyEnabledCheckBox_OnChanged"
                                  Unchecked="HotkeyEnabledCheckBox_OnChanged" />
                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="快捷键"
                                       Style="{StaticResource SettingLabelStyle}" />
                            <TextBox x:Name="HotkeyTextBox"
                                     Grid.Column="1"
                                     IsReadOnly="True"
                                     Style="{StaticResource ReadOnlyFieldStyle}"
                                     PreviewKeyDown="HotkeyTextBox_OnPreviewKeyDown" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="桌面待办">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,8,24,24">
                        <TextBlock Text="桌面待办" Style="{StaticResource SectionHeadingStyle}" />
                        <CheckBox x:Name="TodoVisibleCheckBox"
                                  Content="显示桌面待办"
                                  FontSize="14" />
                        <TextBlock Text="显示模式"
                                   Style="{StaticResource SettingLabelStyle}"
                                   Margin="0,20,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="EightDayModeRadioButton"
                                         GroupName="TodoMode"
                                         Content="八日"
                                         Style="{StaticResource SegmentedRadioStyle}" />
                            <RadioButton x:Name="TodayModeRadioButton"
                                         GroupName="TodoMode"
                                         Content="今日"
                                         Style="{StaticResource SegmentedRadioStyle}" />
                            <RadioButton x:Name="CalendarModeRadioButton"
                                         GroupName="TodoMode"
                                         Content="月历"
                                         Style="{StaticResource SegmentedRadioStyle}" />
                        </StackPanel>
                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="54" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="透明度"
                                       Style="{StaticResource SettingLabelStyle}" />
                            <Slider x:Name="TodoOpacitySlider"
                                    Grid.Column="1"
                                    Minimum="0.35"
                                    Maximum="0.95"
                                    SmallChange="0.05"
                                    LargeChange="0.1"
                                    TickFrequency="0.05"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="TodoOpacitySlider_OnValueChanged" />
                            <TextBlock x:Name="TodoOpacityValueTextBlock"
                                       Grid.Column="2"
                                       HorizontalAlignment="Right"
                                       Style="{StaticResource SettingLabelStyle}" />
                        </Grid>
                        <CheckBox x:Name="TodoLockedCheckBox"
                                  Content="锁定桌面位置"
                                  FontSize="14"
                                  Margin="0,20,0,0" />
                        <Button x:Name="ResetTodoAppearanceButton"
                                Content="恢复默认位置和外观"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Left"
                                Margin="0,20,0,0"
                                Click="ResetTodoAppearanceButton_OnClick" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="数据">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,8,24,24">
                        <TextBlock Text="数据" Style="{StaticResource SectionHeadingStyle}" />
                        <TextBlock Text="数据目录"
                                   Style="{StaticResource SettingLabelStyle}"
                                   Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DataFolderTextBox"
                                     Grid.Column="0"
                                     IsReadOnly="True"
                                     Style="{StaticResource ReadOnlyFieldStyle}" />
                            <Button x:Name="OpenDataFolderButton"
                                    Grid.Column="1"
                                    Content="&#xE8B7;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="16"
                                    Style="{StaticResource IconButtonStyle}"
                                    HorizontalAlignment="Right"
                                    ToolTip="打开数据目录"
                                    ToolTipService.InitialShowDelay="0"
                                    Click="OpenDataFolderButton_OnClick" />
                        </Grid>
                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34" />
                                <RowDefinition Height="34" />
                                <RowDefinition Height="34" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="数据库" Style="{StaticResource SettingLabelStyle}" />
                            <TextBlock x:Name="DatabaseSizeTextBlock" Grid.Row="0" Grid.Column="1" Style="{StaticResource SettingLabelStyle}" />
                            <TextBlock Grid.Row="1" Text="附件" Style="{StaticResource SettingLabelStyle}" />
                            <TextBlock x:Name="AttachmentSizeTextBlock" Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingLabelStyle}" />
                            <TextBlock Grid.Row="2" Text="总占用" FontWeight="SemiBold" Style="{StaticResource SettingLabelStyle}" />
                            <TextBlock x:Name="TotalSizeTextBlock" Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" Style="{StaticResource SettingLabelStyle}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="关于">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,8,24,24">
                        <TextBlock Text="关于 QingJian" Style="{StaticResource SectionHeadingStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38" />
                                <RowDefinition Height="38" />
                                <RowDefinition Height="38" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="应用版本" Style="{StaticResource SettingLabelStyle}" />
                            <TextBlock x:Name="AppVersionTextBlock" Grid.Row="0" Grid.Column="1" Style="{StaticResource SettingLabelStyle}" />
                            <TextBlock Grid.Row="1" Text=".NET" Style="{StaticResource SettingLabelStyle}" />
                            <TextBlock x:Name="DotNetVersionTextBlock" Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingLabelStyle}" />
                            <TextBlock Grid.Row="2" Text="WebView2 Runtime" Style="{StaticResource SettingLabelStyle}" />
                            <TextBlock x:Name="WebView2VersionTextBlock" Grid.Row="2" Grid.Column="1" Style="{StaticResource SettingLabelStyle}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SaveErrorTextBlock"
                           Grid.Column="0"
                           Foreground="{StaticResource DangerTextBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Margin="0,0,16,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CancelButton"
                            Content="取消"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CancelButton_OnClick" />
                    <Button x:Name="SaveButton"
                            Content="保存"
                            IsEnabled="False"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="8,0,0,0"
                            Click="SaveButton_OnClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
