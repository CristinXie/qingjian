<Window x:Class="QingJian.App.Views.FolderManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文件夹"
        Icon="/QingJian.App;component/Assets/qingjian.ico"
        AutomationProperties.AutomationId="FolderManagementWindow"
        Width="480"
        Height="520"
        MinWidth="480"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        Loaded="FolderManagementWindow_OnLoaded"
        PreviewKeyDown="FolderManagementWindow_OnPreviewKeyDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="文件夹"
                       FontSize="20"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button x:Name="NewFolderButton"
                    Grid.Column="1"
                    Content="&#xE710;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="15"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTip="新建文件夹"
                    ToolTipService.InitialShowDelay="0"
                    Click="NewFolderButton_OnClick" />
        </Grid>

        <Grid x:Name="NewFolderEditorPanel"
              Grid.Row="1"
              Margin="0,16,0,8">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCreating}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NewFolderTextBox"
                     Grid.Column="0"
                     Height="34"
                     Padding="10,0"
                     VerticalContentAlignment="Center"
                     Text="{Binding EditorText, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1"
                    Content="&#xE73E;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="14"
                    Margin="8,0,0,0"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTip="确认新建"
                    ToolTipService.InitialShowDelay="0"
                    Command="{Binding ConfirmEditCommand}" />
            <Button Grid.Column="2"
                    Content="&#xE711;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="14"
                    Margin="8,0,0,0"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTip="取消新建"
                    ToolTipService.InitialShowDelay="0"
                    Command="{Binding CancelEditCommand}" />
        </Grid>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Button x:Name="AllNotesButton"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Padding="4,8"
                        HorizontalContentAlignment="Stretch"
                        ToolTip="显示全部便签"
                        ToolTipService.InitialShowDelay="0"
                        Click="AllNotesButton_OnClick">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8B7;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="全部便签"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="AllNotesCountTextBlock"
                                   Grid.Column="2"
                                   Text="{Binding AllNotesCount, StringFormat={}({0} 条)}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <ItemsControl x:Name="FolderItemsControl"
                              ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="4,6"
                                    MouseLeftButtonUp="FolderRow_OnMouseLeftButtonUp">
                                <Grid>
                                    <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8B7;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding NoteCount, StringFormat={}({0} 条)}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Margin="8,0,8,0"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="3"
                                            Content="&#xE70F;"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="13"
                                            Style="{StaticResource IconButtonStyle}"
                                            ToolTip="重命名"
                                            ToolTipService.InitialShowDelay="0"
                                            IsEnabled="{Binding CanManage}"
                                            Click="RenameFolderButton_OnClick" />
                                    <Button Grid.Column="4"
                                            Content="&#xE74D;"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="13"
                                            Style="{StaticResource DangerIconButtonStyle}"
                                            ToolTip="删除文件夹"
                                            ToolTipService.InitialShowDelay="0"
                                            IsEnabled="{Binding CanManage}"
                                            Click="DeleteFolderButton_OnClick" />
                                </Grid>
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Height="32"
                                             Padding="10,0"
                                             VerticalContentAlignment="Center"
                                             Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1"
                                            Content="&#xE73E;"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="14"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource IconButtonStyle}"
                                            ToolTip="确认重命名"
                                            ToolTipService.InitialShowDelay="0"
                                            Command="{Binding DataContext.ConfirmEditCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                    <Button Grid.Column="2"
                                            Content="&#xE711;"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="14"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource IconButtonStyle}"
                                            ToolTip="取消重命名"
                                            ToolTipService.InitialShowDelay="0"
                                            Command="{Binding DataContext.CancelEditCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="ErrorTextBlock"
                   Grid.Row="3"
                   Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource DangerTextBrush}"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0" />
    </Grid>
</Window>
