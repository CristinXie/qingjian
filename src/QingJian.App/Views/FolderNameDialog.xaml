<Window x:Class="QingJian.App.Views.FolderNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建文件夹"
        Width="360"
        Height="190"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        Loaded="FolderNameDialog_OnLoaded"
        PreviewKeyDown="FolderNameDialog_OnPreviewKeyDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="34" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="新建文件夹"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,14" />
        <TextBox x:Name="FolderNameTextBox"
                 Grid.Row="1"
                 Height="34"
                 Padding="10,0"
                 VerticalContentAlignment="Center" />
        <TextBlock x:Name="ErrorTextBlock"
                   Grid.Row="2"
                   Foreground="{StaticResource DangerTextBrush}"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0" />
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="CancelButton"
                    Content="&#xE711;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="14"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTip="取消"
                    ToolTipService.InitialShowDelay="0"
                    Click="CancelButton_OnClick" />
            <Button x:Name="ConfirmButton"
                    Content="&#xE73E;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="14"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTip="确认新建"
                    ToolTipService.InitialShowDelay="0"
                    Margin="8,0,0,0"
                    Click="ConfirmButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
