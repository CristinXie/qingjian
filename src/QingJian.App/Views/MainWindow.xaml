<Window x:Class="QingJian.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:QingJian.App.Models"
        xmlns:views="clr-namespace:QingJian.App.Views"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="QingJian"
        Width="1040"
        Height="680"
        MinWidth="760"
        MinHeight="480"
        Background="{StaticResource AppBackgroundBrush}">
    <Window.Resources>
        <views:NoteCreatedAtDisplayConverter x:Key="NoteCreatedAtDisplayConverter" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="288" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="18,20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <Button Content="新建便签"
                            Command="{Binding NewNoteCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button Content="显示/隐藏桌面待办"
                            Margin="0,8,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="ToggleTodoWidgetButton_OnClick" />
                </StackPanel>

                <ListBox ItemsSource="{Binding NotesView}"
                         SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NoteListBoxItemStyle}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Margin="2,12,0,6" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Note}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding Title}"
                                           Foreground="{StaticResource TextBrush}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Text="{Binding Content}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12"
                                           Margin="0,5,0,0"
                                           MaxHeight="34"
                                           TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding UpdatedAt, StringFormat={}{0:MM-dd HH:mm}}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11"
                                           Margin="12,5,0,0"
                                           VerticalAlignment="Top" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="32,24,32,28">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,0,0,14"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TitleTextBox"
                             Grid.Column="0"
                             Text="{Binding SelectedNote.Title, UpdateSourceTrigger=Explicit}"
                             FontSize="24"
                             FontWeight="SemiBold"
                             Margin="0,0,20,0"
                             VerticalAlignment="Center"
                             AcceptsReturn="False"
                             PreviewKeyDown="TitleTextBox_OnPreviewKeyDown"
                             GotKeyboardFocus="TitleTextBox_OnGotKeyboardFocus"
                             LostKeyboardFocus="TitleTextBox_OnLostKeyboardFocus"
                             TextChanged="TitleTextBox_OnTextChanged" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="ModeToggleButton"
                                Content="&#xE8AB;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="15"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="切换到 Markdown"
                                ToolTipService.InitialShowDelay="0"
                                Click="ModeToggleButton_OnClick" />
                        <Button x:Name="UndoButton"
                                Content="&#xE7A7;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="15"
                                Margin="8,0,0,0"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="撤销"
                                ToolTipService.InitialShowDelay="0"
                                Click="UndoButton_OnClick" />
                        <Button x:Name="RedoButton"
                                Content="&#xE7A6;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="15"
                                Margin="8,0,0,0"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="恢复"
                                ToolTipService.InitialShowDelay="0"
                                Click="RedoButton_OnClick" />
                        <Button x:Name="DeleteButton"
                                Content="&#xE74D;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="15"
                                Margin="8,0,0,0"
                                Style="{StaticResource DangerIconButtonStyle}"
                                ToolTip="删除"
                                ToolTipService.InitialShowDelay="0"
                                Click="DeleteButton_OnClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="EditorShell"
                    Grid.Row="1"
                    Background="{StaticResource EditorShellBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <wv2:WebView2 x:Name="MarkdownWebView" Grid.Row="0" />
                    <Border x:Name="MarkdownEditorFallback"
                            Grid.Row="0"
                            Visibility="Collapsed"
                            Background="{StaticResource EditorShellBackgroundBrush}"
                            Padding="16">
                        <TextBlock Text="Markdown 编辑器暂时不可用，但标题和便签列表仍可使用。"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </Border>
                    <Border Grid.Row="1"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="12,7">
                        <TextBlock x:Name="CreatedAtTextBlock"
                                   Text="{Binding SelectedNote.CreatedAt, Converter={StaticResource NoteCreatedAtDisplayConverter}}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="360">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="还没有便签"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="创建第一条便签，轻轻放下脑子里的东西。"
                       Foreground="{StaticResource MutedTextBrush}"
                       Margin="0,8,0,18"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center" />
            <Button Content="新建便签"
                    Command="{Binding NewNoteCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
