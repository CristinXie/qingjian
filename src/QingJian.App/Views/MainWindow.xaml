<Window x:Class="QingJian.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:QingJian.App.Models"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="QingJian"
        Width="1040"
        Height="680"
        MinWidth="760"
        MinHeight="480"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="288" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="18,20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <Button Content="新建便签"
                            Command="{Binding NewNoteCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button Content="显示/隐藏桌面待办"
                            Margin="0,8,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="ToggleTodoWidgetButton_OnClick" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Notes}"
                         SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NoteListBoxItemStyle}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Note}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding Title}"
                                           Foreground="{StaticResource TextBrush}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Text="{Binding Content}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12"
                                           Margin="0,5,0,0"
                                           MaxHeight="34"
                                           TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding UpdatedAt, StringFormat={}{0:MM-dd HH:mm}}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11"
                                           Margin="12,5,0,0"
                                           VerticalAlignment="Top" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="32,24,32,28">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,0,0,14"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TitleTextBox"
                             Grid.Column="0"
                             Text="{Binding SelectedNote.Title, UpdateSourceTrigger=Explicit}"
                             FontSize="24"
                             FontWeight="SemiBold"
                             Margin="0,0,20,0"
                             VerticalAlignment="Center"
                             AcceptsReturn="False"
                             GotKeyboardFocus="TitleTextBox_OnGotKeyboardFocus"
                             LostKeyboardFocus="TitleTextBox_OnLostKeyboardFocus"
                             TextChanged="TitleTextBox_OnTextChanged" />

                    <Button Grid.Column="1"
                            Content="删除"
                            Command="{Binding DeleteSelectedNoteCommand}"
                            Style="{StaticResource SubtleDangerButtonStyle}"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border x:Name="EditorShell"
                    Grid.Row="1"
                    Background="{StaticResource EditorShellBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <wv2:WebView2 x:Name="MarkdownWebView" />
                    <Border x:Name="MarkdownEditorFallback"
                            Visibility="Collapsed"
                            Background="{StaticResource EditorShellBackgroundBrush}"
                            Padding="16">
                        <TextBlock Text="Markdown 编辑器暂时不可用，但标题和便签列表仍可使用。"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="360">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="还没有便签"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="创建第一条便签，轻轻放下脑子里的东西。"
                       Foreground="{StaticResource MutedTextBrush}"
                       Margin="0,8,0,18"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center" />
            <Button Content="新建便签"
                    Command="{Binding NewNoteCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
