<Window x:Class="QingJian.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:QingJian.App.Models"
        xmlns:views="clr-namespace:QingJian.App.Views"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="QingJian"
        Width="1040"
        Height="680"
        MinWidth="760"
        MinHeight="480"
        Background="{StaticResource AppBackgroundBrush}">
    <Window.Resources>
        <views:NoteCreatedAtDisplayConverter x:Key="NoteCreatedAtDisplayConverter" />
        <views:NoteUpdatedAtDisplayConverter x:Key="NoteUpdatedAtDisplayConverter" />
        <views:MarkdownBodyStatsDisplayConverter x:Key="MarkdownBodyStatsDisplayConverter" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="288" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="18,20">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button Content="新建便签"
                            Command="{Binding NewNoteCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button x:Name="TodoWidgetToggleButton"
                            Margin="0,8,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="ToggleTodoWidgetButton_OnClick" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="32" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Height="32"
                                Margin="0,0,8,0"
                                Background="#FAF9F7"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8" />
                        <TextBox x:Name="NoteSearchTextBox"
                                 Grid.Column="0"
                                 Margin="9,0,17,0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="False"
                                 VerticalContentAlignment="Center" />
                        <TextBlock Grid.Column="0"
                                   Text="搜索便签"
                                   Margin="9,0,17,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=NoteSearchTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Button x:Name="NavigationSortButton"
                                Grid.Column="1"
                                Width="32"
                                Height="32"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="15"
                                Command="{Binding ToggleNavigationSortCommand}"
                                ToolTipService.InitialShowDelay="0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                    <Setter Property="Content" Value="&#xE823;" />
                                    <Setter Property="ToolTip" Value="按收藏" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NavigationSortMode}" Value="Favorite">
                                            <Setter Property="Content" Value="&#xE734;" />
                                            <Setter Property="ToolTip" Value="按时间" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <StackPanel x:Name="ActiveFolderFilterPanel"
                                Orientation="Horizontal"
                                Margin="0,8,0,0"
                                VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasFolderFilter}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE8B7;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentFolderDisplayName}"
                                   MaxWidth="185"
                                   Margin="6,0,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <Button x:Name="ClearFolderFilterButton"
                                Content="&#xE711;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="12"
                                Width="24"
                                Height="24"
                                MinHeight="0"
                                Margin="6,0,0,0"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="显示全部便签"
                                ToolTipService.InitialShowDelay="0"
                                Click="ClearFolderFilterButton_OnClick" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom"
                            Orientation="Horizontal"
                            Margin="0,12,0,0">
                    <Button x:Name="SettingsButton"
                            Content="&#xE713;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="15"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="设置"
                            ToolTipService.InitialShowDelay="0"
                            Click="SettingsButton_OnClick" />
                    <Button x:Name="FolderButton"
                            Content="&#xE8B7;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="15"
                            Margin="8,0,0,0"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="文件夹"
                            ToolTipService.InitialShowDelay="0"
                            Click="FolderButton_OnClick" />
                    <Button x:Name="BatchManagementButton"
                            Content="&#xE762;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="15"
                            Margin="8,0,0,0"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="批量管理"
                            ToolTipService.InitialShowDelay="0" />
                </StackPanel>

                <Grid>
                    <ListBox ItemsSource="{Binding NotesView}"
                             SelectedItem="{Binding SelectedNote, Mode=OneWay}"
                             SelectionChanged="NoteListBox_OnSelectionChanged"
                             ItemContainerStyle="{StaticResource NoteListBoxItemStyle}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Margin="2,12,0,6" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:Note}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24" />
                                        <RowDefinition Height="24" />
                                        <RowDefinition Height="24" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Text="{Binding Title}"
                                               Foreground="{StaticResource TextBrush}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button x:Name="FavoriteButton"
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Width="24"
                                            Height="24"
                                            MinHeight="0"
                                            Margin="8,0,0,0"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="14"
                                            Focusable="False"
                                            ToolTipService.InitialShowDelay="0"
                                            PreviewMouseLeftButtonDown="FavoriteButton_OnPreviewMouseLeftButtonDown">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                                <Setter Property="Content" Value="&#xE734;" />
                                                <Setter Property="ToolTip" Value="收藏" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                        <Setter Property="Content" Value="&#xE735;" />
                                                        <Setter Property="Foreground" Value="#F5C542" />
                                                        <Setter Property="ToolTip" Value="取消收藏" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <TextBlock Grid.Row="1"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding UpdatedAt, Converter={StaticResource NoteUpdatedAtDisplayConverter}}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                    <Button x:Name="FolderAssignmentButton"
                                            Grid.Row="2"
                                            Grid.ColumnSpan="2"
                                            MinHeight="0"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            HorizontalContentAlignment="Left"
                                            VerticalContentAlignment="Center"
                                            Focusable="False"
                                            ToolTip="移动到文件夹"
                                            ToolTipService.InitialShowDelay="0"
                                            Click="FolderAssignmentButton_OnClick">
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="&#xE8B7;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding FolderName}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="11"
                                                       Margin="5,0,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="NoSearchResultsTextBlock"
                               Text="没有匹配的便签"
                               Foreground="{StaticResource MutedTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,28,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowNoSearchResults}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock x:Name="FolderEmptyTextBlock"
                               Text="没有便签"
                               Foreground="{StaticResource MutedTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,28,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowFolderEmptyState}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="32,24,32,28">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,0,0,14"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TitleTextBox"
                             Grid.Column="0"
                             Text="{Binding SelectedNote.Title, UpdateSourceTrigger=Explicit}"
                             FontSize="24"
                             FontWeight="SemiBold"
                             Margin="0,0,20,0"
                             VerticalAlignment="Center"
                             AcceptsReturn="False"
                             PreviewKeyDown="TitleTextBox_OnPreviewKeyDown"
                             GotKeyboardFocus="TitleTextBox_OnGotKeyboardFocus"
                             LostKeyboardFocus="TitleTextBox_OnLostKeyboardFocus"
                             TextChanged="TitleTextBox_OnTextChanged" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="ModeToggleButton"
                                Content="&#xE8AB;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="15"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="切换到 Markdown"
                                ToolTipService.InitialShowDelay="0"
                                Click="ModeToggleButton_OnClick" />
                        <Button x:Name="UndoButton"
                                Content="&#xE7A7;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="15"
                                Margin="8,0,0,0"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="撤销"
                                ToolTipService.InitialShowDelay="0"
                                Click="UndoButton_OnClick" />
                        <Button x:Name="RedoButton"
                                Content="&#xE7A6;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="15"
                                Margin="8,0,0,0"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="恢复"
                                ToolTipService.InitialShowDelay="0"
                                Click="RedoButton_OnClick" />
                        <Button x:Name="DeleteButton"
                                Content="&#xE74D;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="15"
                                Margin="8,0,0,0"
                                Style="{StaticResource DangerIconButtonStyle}"
                                ToolTip="删除"
                                ToolTipService.InitialShowDelay="0"
                                Click="DeleteButton_OnClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="EditorShell"
                    Grid.Row="1"
                    Background="{StaticResource EditorShellBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <wv2:WebView2 x:Name="MarkdownWebView" Grid.Row="0" />
                    <Border x:Name="MarkdownEditorFallback"
                            Grid.Row="0"
                            Visibility="Collapsed"
                            Background="{StaticResource EditorShellBackgroundBrush}"
                            Padding="16">
                        <TextBlock Text="Markdown 编辑器暂时不可用，但标题和便签列表仍可使用。"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </Border>
                    <Grid Grid.Row="1" Margin="12,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="BodyStatsTextBlock"
                                   Grid.Column="0"
                                   Text="{Binding SelectedNote.Content, Converter={StaticResource MarkdownBodyStatsDisplayConverter}}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11" />
                        <TextBlock x:Name="CreatedAtTextBlock"
                                   Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   Text="{Binding SelectedNote.CreatedAt, Converter={StaticResource NoteCreatedAtDisplayConverter}}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="360">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="还没有便签"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="创建第一条便签，轻轻放下脑子里的东西。"
                       Foreground="{StaticResource MutedTextBrush}"
                       Margin="0,8,0,18"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center" />
            <Button Content="新建便签"
                    Command="{Binding NewNoteCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
